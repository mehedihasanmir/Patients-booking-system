LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=bytevoice

API_BASE_URL=http://localhost:8000
SERVICE_TOKEN=dev-service-token-change-me

OPENAI_API_KEY=
# Speech-to-text uses the same OpenAI key. gpt-4o-mini-transcribe with Bangla.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=bn
# Bangla speech. coral is a warm female voice. gpt-4o-mini-tts follows the Bangla instruction.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# auto: OpenAI STT and OpenAI TTS. Google only when credentials exist.
TTS_PROVIDER=auto
STT_PROVIDER=auto
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_VOICE=bn-IN-Wavenet-A

LOG_LEVEL=INFO
