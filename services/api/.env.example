APP_ENV=local
LOG_LEVEL=INFO

# Local docker-compose Postgres. Neon example:
# postgresql+asyncpg://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/bytevoice?ssl=require
DATABASE_URL=postgresql+asyncpg://bytevoice:bytevoice@localhost:5432/bytevoice

JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=720
SERVICE_TOKEN=dev-service-token-change-me

CORS_ORIGINS=http://localhost:3000
CLINIC_TIMEZONE=Asia/Dhaka

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=bytevoice

OPENAI_API_KEY=

# Demo-only reviewer login. Change before any public deploy.
SEED_ADMIN_EMAIL=reviewer@strategybyte.demo
SEED_ADMIN_PASSWORD=ReviewerDemo!2026
SEED_STAFF_EMAIL=staff@strategybyte.demo
SEED_STAFF_PASSWORD=StaffDemo!2026
SEED_ON_START=true

TOKEN_RATE_LIMIT=5
TOKEN_RATE_WINDOW_S=60

# Optional call recordings. Leave R2_ENABLED=false to skip Egress cleanly.
R2_ENABLED=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
